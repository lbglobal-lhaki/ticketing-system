generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CabinClass {
  economy
  business
}

enum TripType {
  one_way
  round_trip
}

enum DemandEventType {
  view
  hold
  purchase
}

enum QuoteStatus {
  active
  used
  expired
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  hold_expired
}

enum PaymentMethod {
  card
  bank_transfer
  cash
}

enum BookingSource {
  online
  walk_in
}

enum PassengerType {
  adult
  child
  infant
}

enum InvoiceStatus {
  unpaid
  paid
  cancelled
  failed
}

enum CargoSubmissionStatus {
  new
  reviewed
  closed
}

enum CargoEmailRole {
  sender
  receiver
}

enum CargoEmailStatus {
  draft
  sent
}

enum DeletedEntityType {
  flight
  booking
  invoice
  cargo
}

/// One physical departure. Cabins are *not* separate flights — a single
/// aircraft carries both, so cabin lives on FareRelease and one Flight row
/// holds every cabin's fare buckets (e.g. 20 business + 120 economy = 140).
model Flight {
  id             String     @id @default(cuid())
  airline        String
  flightNumber   String
  origin         String
  destination    String
  departureAt    DateTime
  arrivalAt      DateTime
  currency       String     @default("AUD")
  /// Sum of every cabin's fare-release seat pools (whole aircraft).
  totalSeats     Int
  remainingSeats Int
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  /// Fixed charter round-trip partner — the return leg sold alongside this
  /// (outbound) flight so customers pick "Round trip" without a second
  /// manual search. Only set on the earlier-departing leg of a pair.
  returnLegFlightId String?
  returnLegFlight   Flight?  @relation("FlightReturnLeg", fields: [returnLegFlightId], references: [id], onDelete: SetNull)
  /// Flights that point at this one as their return leg (reverse of above).
  returnLegOf       Flight[] @relation("FlightReturnLeg")

  fareReleases   FareRelease[]
  /// Legacy demand-tracking rows (no longer used for pricing).
  demandEvents   DemandEvent[]
  quotes         PriceQuote[]  @relation("OutboundQuotes")
  returnQuotes   PriceQuote[]  @relation("ReturnQuotes")
  bookings       Booking[]     @relation("OutboundBookings")
  returnBookings Booking[]     @relation("ReturnBookings")

  @@index([origin, destination, departureAt])
  @@index([active])
  @@index([returnLegFlightId])
}

/// Fare bucket sold in order (Early Bird → Standard → Final Release) *within a
/// cabin*. The cabin lives here rather than on Flight so one departure can sell
/// business and economy side by side; a booking's cabin is its fare release's.
model FareRelease {
  id             String     @id @default(cuid())
  flightId       String
  flight         Flight     @relation(fields: [flightId], references: [id], onDelete: Cascade)
  cabinClass     CabinClass @default(economy)
  name           String
  sortOrder      Int
  totalSeats     Int
  remainingSeats Int
  /// Admin-controlled one-way ticket price for this release (cents). 0 = not priced yet.
  priceCents     Int    @default(0)
  /// Admin-controlled round-trip leg price for this release (cents). 0 = not priced yet.
  /// Used when the booking is round-trip; independent of priceCents (not 2×).
  roundTripPriceCents Int @default(0)
  active         Boolean @default(true)

  quotes         PriceQuote[] @relation("OutboundFare")
  returnQuotes   PriceQuote[] @relation("ReturnFare")
  bookings       Booking[]    @relation("OutboundFareBooking")
  returnBookings Booking[]    @relation("ReturnFareBooking")

  @@index([flightId, cabinClass, sortOrder])
}

model DemandEvent {
  id        String          @id @default(cuid())
  flightId  String
  flight    Flight          @relation(fields: [flightId], references: [id], onDelete: Cascade)
  type      DemandEventType
  sessionId String
  createdAt DateTime        @default(now())

  @@index([flightId, createdAt])
  @@index([sessionId])
}

model PriceQuote {
  id                     String      @id @default(cuid())
  flightId               String
  flight                 Flight      @relation("OutboundQuotes", fields: [flightId], references: [id], onDelete: Cascade)
  fareReleaseId          String?
  fareRelease            FareRelease? @relation("OutboundFare", fields: [fareReleaseId], references: [id])
  returnFlightId         String?
  returnFlight           Flight?     @relation("ReturnQuotes", fields: [returnFlightId], references: [id], onDelete: Cascade)
  returnFareReleaseId    String?
  returnFareRelease      FareRelease? @relation("ReturnFare", fields: [returnFareReleaseId], references: [id])
  tripType               TripType    @default(one_way)
  sessionId              String
  quotedPriceCents       Int
  outboundPriceCents     Int
  returnPriceCents       Int         @default(0)
  basePriceSnapshotCents Int
  fareReleaseName        String      @default("")
  returnFareReleaseName  String      @default("")
  fareProductCode        String      @default("")
  fareProductName        String      @default("")
  demandMultiplier       Float
  scarcityMultiplier     Float
  baseMarkup             Float
  expiresAt              DateTime
  status                 QuoteStatus @default(active)
  /// Passenger draft collected before payment
  passengerTitle         String      @default("")
  passengerFirstName     String      @default("")
  passengerLastName      String      @default("")
  passengerEmail         String      @default("")
  passengerPhone         String      @default("")
  passportNumber         String      @default("")
  nationality            String      @default("")
  seatsBooked            Int         @default(1)
  /// Party mix for online checkout (infants do not consume seats).
  adultCount             Int         @default(1)
  childCount             Int         @default(0)
  infantCount            Int         @default(0)
  /// Adult package fare used for 75%/10% child/infant rates (cents).
  unitAdultFareCents     Int         @default(0)
  /// Draft travellers collected on the passengers step (JSON array).
  travellersDraft        Json        @default("[]")
  /// Party-level special assistance notes (wheelchair, language, other).
  specialAssistance      Json        @default("{}")
  privacyAccepted        Boolean     @default(false)
  /// Soft inventory hold for quote TTL (seats already decremented when true)
  inventoryHeld          Boolean     @default(false)
  heldSeats              Int         @default(0)
  createdAt              DateTime    @default(now())

  booking Booking?

  @@index([sessionId])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

model Booking {
  id                  String         @id @default(cuid())
  quoteId             String?        @unique
  quote               PriceQuote?    @relation(fields: [quoteId], references: [id])
  flightId            String
  flight              Flight         @relation("OutboundBookings", fields: [flightId], references: [id])
  fareReleaseId       String?
  fareRelease         FareRelease?   @relation("OutboundFareBooking", fields: [fareReleaseId], references: [id])
  returnFlightId      String?
  returnFlight        Flight?        @relation("ReturnBookings", fields: [returnFlightId], references: [id])
  returnFareReleaseId String?
  returnFareRelease   FareRelease?   @relation("ReturnFareBooking", fields: [returnFareReleaseId], references: [id])
  tripType            TripType       @default(one_way)
  passengerName       String
  email               String
  passengerPhone      String         @default("")
  passportNumber      String         @default("")
  nationality         String         @default("")
  seatsBooked         Int            @default(1)
  amountPaidCents     Int
  serviceFeeCents     Int            @default(0)
  fareReleaseName     String         @default("")
  fareProductCode     String         @default("")
  fareProductName     String         @default("")
  /// Extra checked bags purchased at booking time (piece count) — admin-priced,
  /// charge lives on the invoice's extraBaggageCents line.
  extraBaggageKg      Int            @default(0)
  /// Party-level special assistance notes (wheelchair, language, other).
  specialAssistance   Json           @default("{}")
  paymentMethod       PaymentMethod?
  source              BookingSource  @default(online)
  status              BookingStatus  @default(pending_payment)
  bookingRef          String         @unique
  ticketNumber        String         @unique
  /// Secret for document/confirmation URLs (unguessable; required in query ?t=)
  accessToken         String         @unique
  /// Bank-transfer seat hold deadline (admin-set; 48h default). Null once confirmed/cancelled/expired.
  holdExpiresAt       DateTime?
  createdAt           DateTime       @default(now())
  invoice             Invoice?
  passengers          BookingPassenger[]

  @@index([flightId])
  @@index([email])
  @@index([status, holdExpiresAt])
  @@index([createdAt])
}

/// Named travellers on a booking (primary + extras). Online single-pax
/// bookings may omit rows and fall back to Booking.passengerName fields.
/// Infants do not consume a seat (`allocatesSeat=false`); children do.
model BookingPassenger {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sortOrder      Int           @default(0)
  fullName       String
  email          String        @default("")
  phone          String        @default("")
  passportNumber String        @default("")
  nationality    String        @default("")
  passengerType  PassengerType @default(adult)
  /// Required for child/infant. Age on the outbound departure date decides
  /// the type: under 2 = infant, 2–11 = child. Adults leave this null.
  dateOfBirth    DateTime?
  /// Admin-set fare for child/infant (cents). Adults keep 0 (system fare).
  priceCents     Int           @default(0)
  /// False for infants — they travel on a ticket but take no seat.
  allocatesSeat  Boolean       @default(true)
  ticketNumber   String        @unique
  /// Outbound ticket is `ticketNumber`. Round-trip return sheet uses this.
  returnTicketNumber String?   @unique
  /// Per-passenger PNR (LB8941, LB8942, …). Falls back to Booking.bookingRef.
  bookingRef     String?       @unique
  /// Chosen seats on the Drukair A320neo map (e.g. 12A). Empty until selected.
  seatOutbound   String        @default("")
  seatReturn     String        @default("")
  seatFeeCents   Int           @default(0)
  createdAt      DateTime      @default(now())

  @@index([bookingId])
}

model Invoice {
  id                String         @id @default(cuid())
  invoiceNumber     String         @unique
  bookingId         String         @unique
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentMethod     PaymentMethod
  status            InvoiceStatus  @default(unpaid)
  amountCents       Int
  fareCents         Int            @default(0)
  serviceFeeCents   Int            @default(0)
  /// Editable airfare invoice line items (AUD cents)
  airfareCents         Int         @default(0)
  airportTaxesCents    Int         @default(0)
  extraBaggageCents    Int         @default(0)
  travelInsuranceCents Int         @default(0)
  otherChargesCents    Int         @default(0)
  gstRateBps           Int         @default(1000)
  gstIncluded          Boolean     @default(true)
  /// When > 0, use this exact GST amount (cents) instead of rate-based calc.
  gstOverrideCents     Int         @default(0)
  accountNumber        String      @default("")
  businessTpn          String      @default("")
  routeLabel           String      @default("")
  seatLabel            String      @default("")
  nameRef              String      @default("")
  endorsementText      String      @default("")
  fareCalculationLine  String      @default("")
  currency          String         @default("AUD")
  /// Unique when set — one Stripe PaymentIntent can only fulfill one invoice.
  stripePaymentIntentId String?    @unique
  bankAccountName   String?
  bankBsb           String?
  bankAccountNumber String?
  bankReference     String?
  customerName     String
  customerEmail     String
  customerPhone     String         @default("")
  notes             String         @default("")
  dueAt             DateTime?
  sentAt            DateTime?
  /// When the travel document / e-ticket email was last sent.
  travelDocSentAt   DateTime?
  paidAt            DateTime?
  markedPaidByAdmin Boolean        @default(false)
  /// Private Vercel Blob URL for the generated PDF (null until first render/upload)
  pdfBlobUrl        String?
  /// Stable Blob pathname used for overwrite on regenerate (e.g. invoices/INV-….pdf)
  pdfBlobPathname   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
}

model PricingConfig {
  id                  String   @id @default(cuid())
  name                String   @unique @default("default")
  baseMarkup          Float    @default(0.08)
  demandWindowMinutes Int      @default(45)
  quoteTtlMinutes     Int      @default(15)
  maxUplift           Float    @default(0.25)
  demandBands         Json
  scarcityBands       Json
  updatedAt           DateTime @updatedAt
}

/// Admin-editable charter fare catalogue (Saver / Standard / Flexi / …).
model CharterFareProduct {
  id                 String     @id @default(cuid())
  code               String     @unique
  name               String
  cabinClass         CabinClass
  sortOrder          Int
  /// One-way catalogue price (cents).
  priceCents         Int
  /// Full round-trip package total for both legs (cents). 0 = not priced yet.
  roundTripPriceCents Int       @default(0)
  currency           String     @default("AUD")
  tagline            String     @default("")
  recommended        Boolean    @default(false)
  mostPopular        Boolean    @default(false)
  active             Boolean    @default(true)
  flightChangeLabel  String
  refundLabel        String
  checkedBaggage     String
  cabinBaggage       String     @default("7kg")
  seatSelection      String
  mealLabel          String     @default("Meal Included")
  frequentFlyerLabel String     @default("Not Applicable")
  priorityCheckIn    String     @default("No")
  priorityBoarding   String     @default("No")
  changePermitted    Boolean    @default(true)
  changeFeeLabel     String     @default("")
  refundPermitted    Boolean    @default(false)
  refundFeeLabel     String     @default("")
  /// Extra perk lines shown on the card / details modal
  perkLines          Json
  changeBullets      Json
  refundBullets      Json
  baggageBullets     Json
  nameChangeBullets  Json
  noShowBullets      Json
  loyaltyBullets     Json
  notes              String     @default("")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([cabinClass, sortOrder])
  @@index([active])
}

/// Google Form cargo enquiry — ingested via /api/cargo/submit.
model CargoSubmission {
  id               String                @id @default(cuid())
  /// Auto-assigned public cargo / parcel reference (e.g. CGO-20260801-A3F91C).
  parcelNumber     String                @unique
  status           CargoSubmissionStatus @default(new)
  /// Admin-marked payment state for the cargo enquiry.
  paid             Boolean               @default(false)
  paidAt           DateTime?
  submitterName    String?
  email            String?
  phone            String?
  /// Full map of form question title → answer
  answers          Json
  googleResponseId String?               @unique
  notes            String?
  submittedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  emailNotices     CargoEmailNotice[]

  @@index([status])
  @@index([paid])
  @@index([createdAt])
  @@index([email])
  @@index([parcelNumber])
}

/// Admin-controlled cargo email draft / send record (not auto-sent).
model CargoEmailNotice {
  id             String          @id @default(cuid())
  cargoId        String
  cargo          CargoSubmission @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  role           CargoEmailRole
  toEmail        String
  toName         String          @default("")
  subject        String
  bodyHtml       String
  bodyText       String          @default("")
  /// Admin notes for pickup / arrival (baked into template; editable in body after).
  pickupLocation String          @default("")
  arrivalNote    String          @default("")
  status         CargoEmailStatus @default(draft)
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([cargoId, role])
  @@index([cargoId, status])
  @@index([createdAt])
}

/// Brute-force guard for /admin login (keyed by hashed client IP).
model AdminLoginGuard {
  key             String    @id
  failedCount     Int       @default(0)
  windowStartedAt DateTime  @default(now())
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Audit trail for admin deletions — Flights / Bookings / Invoices / Cargo.
/// Deleting the live row does not remove the record here, so ops can always
/// see what was removed, by whom, and a full snapshot of the data.
model DeletedRecord {
  id         String            @id @default(cuid())
  entityType DeletedEntityType
  /// Id of the row that was deleted (row itself no longer exists).
  entityId   String
  /// Human-friendly title for list display (e.g. flight number, booking ref).
  label      String
  /// Secondary context line (e.g. passenger name, route, amount).
  summary    String            @default("")
  /// Full JSON snapshot of the row (and light relations) at deletion time.
  snapshot   Json
  deletedAt  DateTime          @default(now())
  deletedBy  String            @default("admin")

  @@index([entityType, deletedAt])
  @@index([deletedAt])
}
