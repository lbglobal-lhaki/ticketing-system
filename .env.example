# =============================================================================
# PRODUCTION CHECKLIST (set all of these before go-live)
# =============================================================================
# DATABASE_URL          — Railway/Postgres connection string
# Stripe                — STRIPE_SECRET_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#                         (use sk_live_/pk_live_ keys in production)
# Bank                  — BANK_NAME, BANK_ACCOUNT_NAME, BANK_BSB, BANK_ACCOUNT_NUMBER
# Email                 — TICKETING_SMTP_USER/PASS + ACCOUNTS_SMTP_USER/PASS
#                         (two Gmail mailboxes, each needs a Google "App Password")
# CRON_SECRET           — long random secret for /api/cron/expire-holds
# CARGO_FORM_SECRET     — Bearer secret for Google Form → /api/cargo/submit
# NEXT_PUBLIC_SITE_URL  — public https:// domain (no trailing slash)
# ADMIN_PASSWORD        — strong admin dashboard password
# BRAND_PAYMENT_PROOF_EMAIL — inbox for bank-transfer screenshot proofs
# =============================================================================

# Railway Postgres (or any Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway?sslmode=require"

# Admin dashboard password
ADMIN_PASSWORD="changeme"

# Public site URL (used in email links, e.g. "View invoice online").
# IMPORTANT: NEXT_PUBLIC_* vars are baked into the app at build time.
# On Vercel, set this under Project Settings -> Environment Variables for the
# Production environment (no trailing slash), then redeploy — editing this
# local .env file has no effect on what's already deployed.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Branding — L&B Global is the primary site brand (booking agent); Drukair
# remains the operating airline mentioned within flights/tickets/invoices.
NEXT_PUBLIC_BRAND_SHORT_NAME="L&B Global"
BRAND_AIRLINE_NAME="Drukair – Royal Bhutan Airlines"
BRAND_SHORT_NAME="L&B Global"
BRAND_BOOKING_PREFIX="LBG"
BRAND_RESERVATIONS_TEAM="Chartered Flight Team"
BRAND_SUPPORT_EMAIL="ticketing@lbglobal.com.au"
BRAND_ISSUING_AGENT="L&B Global"
BRAND_ISSUING_AIRLINE="DrukAir"
BRAND_AGENT_PHONE_PRIMARY="+61 424 919 833"
BRAND_AGENT_PHONE_SECONDARY="+61 451 106 077"
BRAND_AGENT_WEBSITE="www.lbglobal.com"
BRAND_AGENT_EMAIL="ticketing@lbglobal.com.au"
BRAND_INVOICE_ACCOUNT_NUMBER="CA216212900"
BRAND_INVOICE_BUSINESS_TPN="LAC00357"
BRAND_CHARTER_TAGLINE="YOUR JOURNEY, OUR COMMITMENT"
BRAND_CARRY_ON_KG="7kg"
BRAND_CHECKED_KG="23kg"
BRAND_ARRIVE_HOURS="3"

# Stripe payments — get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Bank transfer invoice details
BANK_NAME="Commonwealth Bank"
BANK_ACCOUNT_NAME="Drukair Australia"
BANK_BSB="123-456"
BANK_ACCOUNT_NUMBER="12345678"

# Email — two real Gmail (Google Workspace) mailboxes, one per purpose.
# Create an "App Password" for each account (requires 2-Step Verification on
# the Google account): https://myaccount.google.com/apppasswords
#
# Ticketing — sends e-tickets / itineraries / booking confirmations and
# seat-hold-expired notices.
TICKETING_SMTP_USER="ticketing@lbglobal.com.au"
TICKETING_SMTP_PASS="google-app-password-here"
# Optional overrides (defaults assume Gmail: smtp.gmail.com:465, secure):
# TICKETING_EMAIL="ticketing@lbglobal.com.au"
# TICKETING_DISPLAY_NAME="Chartered Flight Team"
# TICKETING_SMTP_HOST="smtp.gmail.com"
# TICKETING_SMTP_PORT="465"
# TICKETING_SMTP_SECURE="true"

# Accounts — sends tax invoices / receipts and bank-transfer payment
# instructions.
ACCOUNTS_SMTP_USER="accounts@lbglobal.com.au"
ACCOUNTS_SMTP_PASS="google-app-password-here"
# ACCOUNTS_EMAIL="accounts@lbglobal.com.au"
# ACCOUNTS_DISPLAY_NAME="L&B Global Accounts"
# ACCOUNTS_SMTP_HOST="smtp.gmail.com"
# ACCOUNTS_SMTP_PORT="465"
# ACCOUNTS_SMTP_SECURE="true"

# Legacy single-sender fallback — only used if the two mailboxes above are
# NOT configured. Safe to leave unset once TICKETING_/ACCOUNTS_ vars are set.
# EMAIL_FROM="Reservations Team <reservations@yourdomain.com>"
# RESEND_API_KEY=""
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"

# Required in production — protect /api/cron/expire-holds (Bearer token)
CRON_SECRET="replace-with-a-long-random-secret"

# Google Form → Cargo inbox — protect POST /api/cargo/submit (Bearer token).
# Generate a long random string and put the same value in the Apps Script
# (see docs/cargo-google-form.md). Required in production.
CARGO_FORM_SECRET="4ICZJytGedE6mc1NGiZbH38s+x/DvWfrDN6vx4pLQ4o="

# Bank-transfer payment proof inbox (screenshot emails) — the accounts mailbox
BRAND_PAYMENT_PROOF_EMAIL="accounts@lbglobal.com.au"

# PDF generation (invoices / e-tickets) — uses headless Chromium.
# On Vercel, @sparticuz/chromium-min downloads a remote Chromium pack into /tmp.
# Optional override (defaults to the GitHub release matching chromium-min):
# CHROMIUM_PACK_URL="https://github.com/Sparticuz/chromium/releases/download/v143.0.4/chromium-v143.0.4-pack.x64.tar"
# Locally, the app auto-detects Chrome/Edge. Override with:
# PUPPETEER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

# Vercel Blob — private storage for generated invoice PDFs.
# On Vercel: connecting a Blob store auto-adds BLOB_STORE_ID (+ OIDC at runtime).
# Locally: you also need the long-lived read-write token from the Blob store
# page (or run `vercel env pull`). BLOB_WEBHOOK_PUBLIC_KEY is optional.
# BLOB_STORE_ID="store_..."
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# BLOB_WEBHOOK_PUBLIC_KEY="..."
